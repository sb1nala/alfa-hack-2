# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# LLM через OpenAI-совместимый API. По умолчанию — Yandex AI Studio.
# Без LLM_API_KEY и LLM_MODEL бот работает, но вместо ответа присылает только найденные материалы.
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# API-ключ сервисного аккаунта с ролью ai.languageModels.user
LLM_API_KEY=
# Идентификатор каталога Yandex Cloud
LLM_PROJECT=
# Модель: gpt://<идентификатор каталога>/yandexgpt/latest
LLM_MODEL=

# Папка с выгрузкой кейса и файл базы внутри контейнера
DATA_DIR=/app/data
DB_PATH=/app/storage/bot.sqlite3

# Часовой пояс по умолчанию для новых пользователей
DEFAULT_TIMEZONE=Europe/Moscow
